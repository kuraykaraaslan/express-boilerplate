<%
  // A list page: the header (title, subtitle, link actions), optional banners, the list (mounted by /js/data-list.js and the page's
  // own script in /js/lists/) and an optional detail drawer. Specs live in pages/admin.lists.ts.
  var spec = locals.spec;
%>
<div class="space-y-6" id="dl-page" data-tenant-id="<%= locals.tenantId %>" data-root="<%= locals.isRoot ? '1' : '0' %>">
  <%- include('../../kui/modules/ui/PageHeader', { title: spec.title, subtitle: spec.subtitle, actions: spec.actions || [] }) %>
  <%- spec.above || '' %>
  <div id="dl-root"></div>
  <% if (spec.drawer) { %>
    <%- include('../../kui/modules/ui/Drawer', { id: 'dl-drawer', title: spec.drawer, children: '<div id="dl-drawer-body" class="space-y-5 text-sm"></div>' }) %>
  <% } %>
  <%- spec.below || '' %>
</div>
