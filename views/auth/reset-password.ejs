<%
  // Set-a-new-password page: the page the forgot-password email links to (?resetToken=&email=). Behaviour in /js/reset-password.js.
%>
<div class="min-h-screen flex items-center justify-center px-4 py-10" id="reset-root" data-tenant-id="<%= locals.tenantId || '' %>">
  <div class="w-full max-w-md space-y-6">
    <div class="text-center space-y-1">
      <h1 class="text-2xl font-semibold text-text-primary">Set a new password</h1>
    </div>

    <div class="rounded-xl border border-border bg-surface-raised p-6 space-y-4 shadow-sm">
      <div id="reset-banner" role="alert" class="hidden"></div>

      <div id="reset-done" class="hidden space-y-4 focus:outline-none" tabindex="-1">
        <div class="flex items-start gap-3 rounded-lg border p-3 bg-success-subtle border-success text-success-fg text-sm">
          <i class="fa-solid fa-circle-check mt-0.5 shrink-0" aria-hidden="true"></i>
          <span>Your password has been reset.</span>
        </div>
        <%- include('../../kui/modules/ui/Button', { element: 'a', href: '/auth/login', fullWidth: true, children: 'Sign in' }) %>
      </div>

      <form id="reset-form" novalidate class="hidden space-y-4">
        <%- include('../../kui/modules/ui/Input', {
          id: 'reset-password-username', label: 'Email', type: 'email', name: 'email', readOnly: true,
          iconLeft: '<i class="fa-solid fa-envelope text-xs" aria-hidden="true"></i>'
        }) %>
        <%- include('../../kui/modules/ui/Input', {
          id: 'reset-password-new', label: 'New password', type: 'password', name: 'password', required: true,
          hint: 'Minimum 8 characters',
          iconLeft: '<i class="fa-solid fa-lock text-xs" aria-hidden="true"></i>'
        }) %>
        <%- include('../../kui/modules/ui/Input', {
          id: 'reset-password-confirm', label: 'Confirm new password', type: 'password', name: 'confirmPassword', required: true,
          iconLeft: '<i class="fa-solid fa-lock text-xs" aria-hidden="true"></i>'
        }) %>
        <%- include('../../kui/modules/ui/Button', { type: 'submit', fullWidth: true, children: 'Reset password' }) %>
      </form>
    </div>

    <p class="text-center text-sm text-text-secondary hidden" id="reset-request-new">
      <a id="reset-request-new-link" href="/auth/forgot-password" class="text-primary font-medium hover:underline">Request a new reset link</a>
    </p>
  </div>
</div>
<script src="/js/kui-api.js"></script>
<script src="/js/auth-ui.js"></script>
<script src="/js/reset-password.js"></script>
