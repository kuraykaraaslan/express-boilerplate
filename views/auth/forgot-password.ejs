<%
  // Request-a-reset-link page: the NB forgot-password page on the kui-ejs partial. Behaviour in /js/forgot-password.js.
%>
<div class="min-h-screen flex items-center justify-center px-4 py-10" id="forgot-root" data-tenant-id="<%= locals.tenantId || '' %>">
  <div class="w-full max-w-md space-y-6">
    <div class="text-center space-y-1">
      <h1 class="text-2xl font-semibold text-text-primary">Reset your password</h1>
      <p class="text-sm text-text-secondary">We'll email you a link.</p>
    </div>

    <div class="rounded-xl border border-border bg-surface-raised p-6 space-y-4 shadow-sm">
      <div id="forgot-banner" role="alert" class="hidden"></div>

      <div id="forgot-sent" class="hidden focus:outline-none" tabindex="-1">
        <div class="rounded-lg bg-success-subtle border border-success px-4 py-4 text-sm text-success-fg space-y-1">
          <p class="font-semibold">Check your inbox</p>
          <p>We sent a password reset link to <span class="font-mono" id="forgot-sent-email"></span>.</p>
        </div>
      </div>

      <div id="forgot-form-area">
        <%- include('../../kui/modules/domain/common/auth/ForgotPasswordForm', { action: '#', method: 'post' }) %>
      </div>
    </div>

    <p class="text-center text-sm text-text-secondary">
      Remember your password? <a id="forgot-signin" href="/auth/login" class="text-primary font-medium hover:underline">Sign in</a>
    </p>
  </div>
</div>
<script src="/js/kui-api.js"></script>
<script src="/js/auth-ui.js"></script>
<script src="/js/forgot-password.js"></script>
