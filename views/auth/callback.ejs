<%
  // Where an SSO / SAML / national-ID sign-in lands: confirms the session and goes where a password login goes. Behaviour in /js/callback.js.
%>
<div class="min-h-screen flex items-center justify-center px-4 py-10" id="cb-root" data-tenant-id="<%= locals.tenantId || '' %>">
  <div class="w-full max-w-md">
    <div class="rounded-2xl border border-border bg-surface-raised shadow-sm p-6 sm:p-8 space-y-4">
      <div id="cb-working" role="status" class="space-y-4 text-center">
        <div class="flex justify-center"><i class="fa-solid fa-spinner fa-spin text-2xl text-text-secondary" aria-hidden="true"></i></div>
        <p class="text-sm text-text-secondary">Completing sign in…</p>
      </div>
      <div id="cb-otp" class="hidden"></div>
      <div id="cb-error" class="hidden space-y-4 text-center">
        <div class="flex items-start gap-3 rounded-lg border p-3 text-left bg-error-subtle border-error text-error-fg text-sm" role="alert">
          <i class="fa-solid fa-circle-xmark mt-0.5 shrink-0" aria-hidden="true"></i><span id="cb-error-text"></span>
        </div>
        <a id="cb-back" href="/auth/login" class="text-sm text-primary hover:underline">Back to sign in</a>
      </div>
    </div>
  </div>
</div>
<script src="/js/kui-api.js"></script>
<script src="/js/auth-ui.js"></script>
<script src="/js/otp-step.js"></script>
<script src="/js/callback.js"></script>
