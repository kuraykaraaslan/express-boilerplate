<%
  // Forced change-password step (a session whose account must change its password is sent here). Behaviour in /js/change-password.js.
%>
<div class="min-h-screen flex items-center justify-center px-4 py-10" id="chpw-root" data-tenant-id="<%= locals.tenantId || '' %>">
  <div class="w-full max-w-md space-y-6">
    <div class="text-center space-y-1">
      <h1 class="text-2xl font-semibold text-text-primary">Change your password</h1>
      <p class="text-sm text-text-secondary">Your password must be changed before you can continue.</p>
    </div>

    <div class="rounded-xl border border-border bg-surface-raised p-6 space-y-4 shadow-sm">
      <div id="chpw-banner" role="alert" class="hidden"></div>

      <div id="chpw-done" class="hidden" role="status">
        <div class="flex items-start gap-3 rounded-lg border p-3 bg-success-subtle border-success text-success-fg text-sm">
          <i class="fa-solid fa-circle-check mt-0.5 shrink-0" aria-hidden="true"></i><span>Your password has been changed.</span>
        </div>
      </div>

      <div id="chpw-device-only" class="hidden space-y-3">
        <div class="flex items-start gap-3 rounded-lg border p-3 bg-warning-subtle border-warning text-warning-fg text-sm">
          <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
          <span><strong class="block">Signed out on this device only</strong>This device is signed out, but your session could not be ended on the server. After you sign in again, you can end it under Security on your profile page.</span>
        </div>
      </div>

      <form id="chpw-form" novalidate class="space-y-4">
        <div id="chpw-username-box" class="hidden">
          <%- include('../../kui/modules/ui/Input', {
            id: 'change-password-username', label: 'Email', type: 'email', name: 'email', readOnly: true,
            iconLeft: '<i class="fa-solid fa-envelope text-xs" aria-hidden="true"></i>'
          }) %>
        </div>
        <%- include('../../kui/modules/ui/Input', {
          id: 'change-password-current', label: 'Current password', type: 'password', name: 'currentPassword', required: true,
          iconLeft: '<i class="fa-solid fa-lock text-xs" aria-hidden="true"></i>'
        }) %>
        <%- include('../../kui/modules/ui/Input', {
          id: 'change-password-new', label: 'New password', type: 'password', name: 'newPassword', required: true, hint: 'Minimum 8 characters',
          iconLeft: '<i class="fa-solid fa-lock text-xs" aria-hidden="true"></i>'
        }) %>
        <%- include('../../kui/modules/ui/Input', {
          id: 'change-password-confirm', label: 'Confirm new password', type: 'password', name: 'confirmPassword', required: true,
          iconLeft: '<i class="fa-solid fa-lock text-xs" aria-hidden="true"></i>'
        }) %>
        <%- include('../../kui/modules/ui/Button', { type: 'submit', fullWidth: true, children: 'Change password' }) %>
      </form>
    </div>

    <p class="text-center text-sm text-text-secondary" id="chpw-footer">
      <button type="button" id="chpw-signout" class="text-primary font-medium hover:underline disabled:opacity-50">Sign out instead</button>
    </p>
    <p class="hidden text-center text-sm" id="chpw-continue">
      <a id="chpw-continue-link" href="/auth/login" class="text-primary font-medium hover:underline">Continue to sign in</a>
    </p>
  </div>
</div>
<script src="/js/kui-api.js"></script>
<script src="/js/auth-ui.js"></script>
<script src="/js/change-password.js"></script>
