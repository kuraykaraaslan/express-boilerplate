<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= locals.title || site.title %></title>

  <!-- Anti-FOUC theme script — MUST be first, before any <link> -->
  <script>(function(){var s=localStorage.getItem('theme');var p=window.matchMedia('(prefers-color-scheme:dark)').matches;if(s==='dark'||(s!=='light'&&p))document.documentElement.classList.add('dark')})();</script>

  <!-- Geist / Geist Mono — the same self-hosted files as kui-react's next/font (loaded for all themes) -->
  <link rel="preload" href="/assets/fonts/geist/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/fonts/geist/geist.css" />

  <!-- Font Awesome 7 Free, in the base layer (see the file) — before app CSS -->
  <link rel="stylesheet" href="/assets/css/fontawesome.css" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />

  <!-- App CSS (Tailwind output) -->
  <link rel="stylesheet" href="/assets/css/app.css?v=<%= assetVersion %>" />
  <% if (locals.colorOverrideCss) { %>
  <style id="showcase-color-overrides"><%- colorOverrideCss %></style>
  <% } %>

  <!-- SEO -->
  <meta name="description" content="<%= locals.description || site.description %>" />
  <meta name="keywords" content="<%= site.keywords %>" />
  <meta name="author" content="<%= site.author %>" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <%
    // res.locals.currentPath (set globally in src/app.ts) is the request
    // path without query string, so `?layout=grid`-style variant params
    // don't fragment canonical identity. Every page used to point at
    // the same site.url (docs/phases/phase-7-showcase-and-dx.md 7.4).
    var _canonicalPath = locals.currentPath && locals.currentPath !== '/' ? locals.currentPath : '';
  %>
  <link rel="canonical" href="<%= site.url %><%= _canonicalPath %>" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= site.name %>" />
  <meta property="og:title" content="<%= locals.title || site.title %>" />
  <meta property="og:description" content="<%= locals.description || site.description %>" />
  <meta property="og:url" content="<%= site.url %>" />
  <meta property="og:image" content="<%= site.url %>/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="<%= site.name %> Preview" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= locals.title || site.title %>" />
  <meta name="twitter:description" content="<%= locals.description || site.description %>" />
  <meta name="twitter:image" content="<%= site.url %>/og-image.png" />
  <meta name="twitter:creator" content="<%= site.twitterHandle %>" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  <%- include('../../modules/ui/_script-json', { value: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "url": site.url,
        "name": site.name,
        "description": site.description
      },
      {
        "@type": "Person",
        "name": site.author,
        "url": site.authorUrl
      },
      {
        "@type": "SoftwareApplication",
        "name": site.name,
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "description": site.description,
        "url": site.url,
        "creator": { "@type": "Person", "name": site.author }
      }
    ]
  } }) %>
  </script>

  <% if (site.googleTag) { %>
  <!-- Google Analytics (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.googleTag %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', <%- include('../../modules/ui/_script-json', { value: String(site.googleTag) }) %>);
  </script>
  <% } %>

  <%- locals.extraHead || '' %>
</head>
