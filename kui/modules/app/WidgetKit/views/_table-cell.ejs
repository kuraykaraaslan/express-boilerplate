<%#
  The content of one table cell, by kind (kui-react DataTableView's `renderContent`). Locals: content.
%><%_ var _c = locals.content; _%>
<% if (_c.kind === 'dash') { %><span class="text-text-secondary/60">—</span><% } else if (_c.kind === 'text') { %><%= _c.text %><% } else if (_c.kind === 'badge') { %><%- include('../_pill', { label: _c.label, color: _c.color, icon: _c.icon, size: 'sm', variant: _c.variant }) %><% } else if (_c.kind === 'icon') { %><span class="inline-flex items-center <%= _c.justify %>" title="<%= _c.label %>"><% if (_c.name) { %><%- include('../_icon', { name: _c.name, style: { color: _c.color, fontSize: 14, width: 14, height: 14 } }) %><% } else { %><span class="h-2 w-2 rounded-full" style="background:<%= _c.color %>" aria-hidden="true"></span><% } %><span class="sr-only"><%= _c.label %></span></span><% } else if (_c.kind === 'bar') { %><span class="flex items-center justify-end gap-2"><span role="meter" aria-valuenow="<%= _c.n %>" aria-valuemin="0" aria-valuemax="<%= _c.max %>" aria-label="<%= _c.columnLabel %>" class="h-1.5 flex-1 overflow-hidden rounded-full <%= _c.progress ? 'min-w-16' : 'min-w-12' %>" style="background:<%= _c.trackBackground %>"><span class="block h-full rounded-full" style="width:<%= _c.pct %>%;background:<%= _c.color %>"></span></span><span class="min-w-10 text-right tabular-nums"><%= _c.label %></span></span><% } else if (_c.kind === 'link') { %><a href="<%= _c.href %>" class="<%= widgetKit.linkClass %>"><%= _c.text %></a><% } else if (_c.kind === 'time') { %><time datetime="<%= _c.dateTime %>" title="<%= _c.title %>"><%= _c.text %></time><% } %>
