<%#
  The trend line of stat.sparkline (a 100 × 40 drawing stretched over its box; markers are HTML dots so they stay round).
  Locals: model.
%><%_ var _m = locals.model; _%>
<div class="relative h-full w-full"><svg viewBox="0 0 <%= _m.W %> <%= _m.H %>" preserveAspectRatio="none" class="absolute inset-0 block h-full w-full overflow-visible" role="img" aria-label="<%= _m.ariaLabel %>"><% if (_m.fillMode === 'gradient') { %><defs><linearGradient id="<%= _m.gradientId %>" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="<%= _m.lineColor %>" stop-opacity="<%= _m.fillOpacity %>"></stop><stop offset="100%" stop-color="<%= _m.lineColor %>" stop-opacity="0"></stop></linearGradient></defs><% } %><% if (_m.area) { %><path d="<%= _m.area %>" stroke="none" data-part="area" fill="<%= _m.fillMode === 'gradient' ? 'url(#' + _m.gradientId + ')' : _m.lineColor %>"<% if (_m.fillMode !== 'gradient') { %> fill-opacity="<%= _m.fillOpacity %>"<% } %>></path><% } %><% if (_m.pts.length === 0) { %><line x1="0" y1="<%= _m.H / 2 %>" x2="<%= _m.W %>" y2="<%= _m.H / 2 %>" stroke="var(--border)" stroke-dasharray="4 3" vector-effect="non-scaling-stroke" data-part="baseline"></line><% } %><path d="<%= _m.line %>" fill="none" stroke="<%= _m.lineColor %>" stroke-width="<%= _m.width %>" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" data-part="line"></path></svg><% if (_m.showMinMax) { %><span class="absolute h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full ring-2 ring-surface-raised" data-part="min" title="<%= _m.min.title %>" style="<%= widgetKit.style(_m.min.style) %>"></span><span class="absolute h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full ring-2 ring-surface-raised" data-part="max" title="<%= _m.max.title %>" style="<%= widgetKit.style(_m.max.style) %>"></span><% } %><% if (_m.showLast) { %><span class="absolute h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full ring-2 ring-surface-raised" data-part="last" title="<%= _m.latest.title %>" style="<%= widgetKit.style(_m.latest.style) %>"></span><% } %></div>
