<%# ChatBox's avatar (kui-react ChatBox BoxAvatar): the visitor's user icon or the agent's robot. Local: role. %><div class="flex h-6 w-6 items-center justify-center rounded-full text-xs <%= locals.role === 'user' ? 'bg-primary text-primary-fg' : 'bg-surface-overlay text-text-secondary' %>" aria-hidden="true"><i class="fa-solid <%= locals.role === 'user' ? 'fa-user' : 'fa-robot' %> w-3 h-3"></i></div>
