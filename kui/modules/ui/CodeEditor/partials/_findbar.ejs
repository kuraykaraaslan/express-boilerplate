<%
  // The find / replace bar (M2) — sibling of kui-react parts/FindBar.tsx: plain text, optional
  // match case, previous / next (Enter, Shift+Enter), replace one and replace all (not in a
  // read-only editor). Rendered closed (`hidden`); Ctrl/Cmd+F in the field or the toolbar's find
  // button opens it. The match is selected in the field without taking the focus.

  var m = _m;
  var input = 'h-7 min-w-0 flex-1 rounded-md border border-border bg-surface-base px-2 font-mono text-xs text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus';
  var btn = 'inline-flex h-7 shrink-0 items-center justify-center rounded-md px-1.5 text-xs text-text-secondary transition-colors hover:bg-surface-overlay hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus disabled:opacity-40';
-%>
<div data-kui-codeeditor-find role="search" aria-label="<%= m.find %>" hidden
  class="flex flex-wrap items-center gap-1 border border-b-0 border-border bg-surface-raised px-2 py-1">
  <div class="flex min-w-48 flex-1 items-center gap-1">
    <input type="search" data-kui-codeeditor-find-query aria-label="<%= m.findPlaceholder %>" placeholder="<%= m.findPlaceholder %>" value="" class="<%= input %>" />
    <span data-kui-codeeditor-find-count class="shrink-0 tabular-nums text-[11px] text-text-secondary" aria-live="polite"></span>
    <button type="button" data-kui-codeeditor-find-action="case" class="<%= btn %>" aria-pressed="false" aria-label="<%= m.matchCase %>" title="<%= m.matchCase %>">Aa</button>
    <button type="button" data-kui-codeeditor-find-action="prev" class="<%= btn %>" aria-label="<%= m.findPrev %>" title="<%= m.findPrev %>" disabled>
      <i class="fa-solid fa-chevron-up w-3 h-3" aria-hidden="true"></i>
    </button>
    <button type="button" data-kui-codeeditor-find-action="next" class="<%= btn %>" aria-label="<%= m.findNext %>" title="<%= m.findNext %>" disabled>
      <i class="fa-solid fa-chevron-down w-3 h-3" aria-hidden="true"></i>
    </button>
    <button type="button" data-kui-codeeditor-find-action="close" class="<%= btn %>" aria-label="<%= m.findClose %>" title="<%= m.findClose %>">
      <i class="fa-solid fa-xmark w-3 h-3" aria-hidden="true"></i>
    </button>
  </div>
  <% if (!_readonly) { %>
  <div class="flex min-w-48 flex-1 items-center gap-1">
    <input type="text" data-kui-codeeditor-find-replacement aria-label="<%= m.replacePlaceholder %>" placeholder="<%= m.replacePlaceholder %>" value="" class="<%= input %>" />
    <button type="button" data-kui-codeeditor-find-action="replace" class="<%= btn %>" disabled><%= m.replaceOne %></button>
    <button type="button" data-kui-codeeditor-find-action="replace-all" class="<%= btn %>" disabled><%= m.replaceAll %></button>
  </div>
  <% } %>
</div>
