<%
  // kui-react ChatTypingIndicator. Locals: label, name, avatarUrl, avatarPartial / avatarLocals, showAvatar (default true).
%><div class="mt-3 flex items-end gap-2" data-part="typing"><% if (locals.showAvatar !== false) { %><div class="w-8 shrink-0" aria-hidden="true"><% if (locals.avatarPartial) { %><%- include(locals.avatarPartial, locals.avatarLocals || {}) %><% } else { %><%- include('./_avatar', { name: locals.name || '?', src: locals.avatarUrl }) %><% } %></div><% } %><div class="flex flex-col items-start"><span class="mb-0.5 px-1 text-[11px] font-medium text-text-secondary" data-chat-typing-label><%= locals.label %></span><div class="rounded-2xl rounded-bl-sm bg-surface-overlay px-3.5 py-2.5 text-text-secondary"><%- include('./_dots', { className: '' }) %></div></div></div>
