<%
  // kui-react ChatBubble (modules/ui/ChatThread/ChatBubble.tsx): same DOM and classes. Locals: side, authorName,
  // avatarUrl, avatarPartial / avatarLocals, body (text) or bodyPartial / bodyLocals, time, dateTime, status (text) or
  // statusPartial / statusLocals, delivery, deliveryLabels, attachments, attachmentsLabel, actions, actionsLabel,
  // grouped, showAuthor, showAvatar, pending, pendingLabel, ariaLabel, messageId, className.
  // An action is { id, label, icon? (Font Awesome class), destructive?, disabled?, onClick? (global function name) };
  // its button carries data-chat-action / data-chat-message for the browser script.
  var side = locals.side;
  var own = side === 'own';
  var grouped = locals.grouped === true;
  var pending = locals.pending === true;
  var bodyEmpty = !locals.bodyPartial && (locals.body === null || locals.body === undefined || locals.body === false || locals.body === '');
  var showAvatar = locals.showAvatar !== false;
  var nameShown = !grouped && (locals.showAuthor != null ? locals.showAuthor : !own);
  var avatarShown = showAvatar && !own;
  var actions = (locals.actions || []).filter(Boolean);
  var atts = locals.attachments || [];
  var dl = locals.deliveryLabels || { sent: 'Sent', delivered: 'Delivered', read: 'Read' };
  var cls = locals.className ? ' ' + locals.className : '';
  function size(s) {
    if (typeof s === 'string') return s;
    if (typeof s !== 'number' || !isFinite(s) || s < 0) return '';
    if (s < 1024) return s + ' B';
    if (s < 1024 * 1024) return (s / 1024).toFixed(s < 10 * 1024 ? 1 : 0) + ' KB';
    return (s / (1024 * 1024)).toFixed(1) + ' MB';
  }
  var hasStatus = Boolean(locals.statusPartial) || (locals.status != null && locals.status !== '' && locals.status !== false);
%><% if (side === 'system') { %><article<% if (locals.ariaLabel) { %> aria-label="<%= locals.ariaLabel %>"<% } %><% if (locals.messageId != null) { %> data-message-id="<%= locals.messageId %>"<% } %> data-chat-side="system"<% if (pending) { %> aria-busy="true"<% } %> class="my-3 flex flex-col items-center gap-0.5 text-center<%= cls %>"><div class="max-w-[85%] rounded-full bg-surface-sunken px-3 py-1 text-xs text-text-secondary whitespace-pre-wrap break-words"><% if (locals.bodyPartial) { %><%- include(locals.bodyPartial, locals.bodyLocals || {}) %><% } else if (!bodyEmpty) { %><%= locals.body %><% } %></div><% if (locals.time || hasStatus) { %><p class="inline-flex items-center gap-1.5 text-[10px] text-text-secondary tabular-nums"><% if (locals.time) { %><time<% if (locals.dateTime) { %> datetime="<%= locals.dateTime %>"<% } %>><%= locals.time %></time><% } %><% if (locals.statusPartial) { %><%- include(locals.statusPartial, locals.statusLocals || {}) %><% } else if (hasStatus) { %><%= locals.status %><% } %></p><% } %></article><% } else { %><article<% if (locals.ariaLabel) { %> aria-label="<%= locals.ariaLabel %>"<% } %><% if (locals.messageId != null) { %> data-message-id="<%= locals.messageId %>"<% } %> data-chat-side="<%= own ? 'own' : 'other' %>" data-chat-author="<%= locals.authorName %>"<% if (locals.atMs != null) { %> data-chat-at="<%= locals.atMs %>"<% } %><% if (pending) { %> aria-busy="true"<% } %> class="group flex items-end gap-2 <%= own ? 'flex-row-reverse' : 'flex-row' %> <%= grouped ? 'mt-0.5' : 'mt-3' %><%= cls %>"><% if (avatarShown) { %><div class="w-8 shrink-0<%= grouped ? ' invisible' : '' %>"<% if (grouped) { %> aria-hidden="true"<% } %>><% if (!grouped) { %><% if (locals.avatarPartial) { %><%- include(locals.avatarPartial, locals.avatarLocals || {}) %><% } else { %><%- include('./_avatar', { name: locals.authorName || '?', src: locals.avatarUrl }) %><% } %><% } %></div><% } %><div class="flex min-w-0 max-w-[75%] flex-col <%= own ? 'items-end' : 'items-start' %>"><% if (nameShown) { %><p class="mb-0.5 px-1 text-[11px] font-medium text-text-secondary"><%= locals.authorName %></p><% } %><div data-part="bubble" class="rounded-2xl px-3.5 py-2 text-sm leading-snug whitespace-pre-wrap break-words <%= own ? 'bg-primary text-primary-fg rounded-br-sm' : 'bg-surface-overlay text-text-primary rounded-bl-sm' %>"><% if (pending && bodyEmpty) { %><%- include('./_dots', { className: 'py-1.5 opacity-70' }) %><% } else { %><% if (locals.bodyPartial) { %><%- include(locals.bodyPartial, locals.bodyLocals || {}) %><% } else if (!bodyEmpty) { %><%= locals.body %><% } %><% if (pending) { %><span aria-hidden="true" class="ml-0.5 inline-block h-3.5 w-1.5 translate-y-0.5 animate-pulse rounded-sm bg-current opacity-60"></span><% } %><% } %><% if (pending) { %><span class="sr-only"><%= locals.pendingLabel || 'Writing…' %></span><% } %></div><% if (atts.length > 0) { %><ul aria-label="<%= locals.attachmentsLabel || 'Attachments' %>" class="mt-1 flex flex-wrap gap-1.5<%= own ? ' justify-end' : '' %>"><% atts.forEach(function (file) { var sz = file.size === undefined ? '' : size(file.size); var chip = 'inline-flex max-w-full items-center gap-1.5 rounded-lg border border-border bg-surface-base px-2 py-1 text-xs text-text-primary'; %><li class="max-w-full"><% if (file.href) { %><a href="<%= file.href %>" target="_blank" rel="noreferrer" class="<%= chip %> hover:bg-surface-overlay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus"><% } else { %><span class="<%= chip %>"><% } %><i class="fa-solid fa-paperclip h-3 w-3 shrink-0 text-text-secondary" aria-hidden="true"></i><span class="truncate"><%= file.name %></span><% if (sz) { %><span class="shrink-0 text-text-secondary tabular-nums"><%= sz %></span><% } %><% if (file.href) { %></a><% } else { %></span><% } %></li><% }); %></ul><% } %><% if (locals.time || hasStatus || (own && locals.delivery) || actions.length > 0) { %><div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 px-1 text-[10px] text-text-secondary tabular-nums<%= own ? ' flex-row-reverse' : '' %>"><% if (locals.time) { %><time<% if (locals.dateTime) { %> datetime="<%= locals.dateTime %>"<% } %>><%= locals.time %></time><% } %><% if (locals.statusPartial) { %><%- include(locals.statusPartial, locals.statusLocals || {}) %><% } else if (hasStatus) { %><%= locals.status %><% } %><% if (own && locals.delivery) { %><span class="inline-flex items-center"><i class="fa-solid <%= locals.delivery === 'sent' ? 'fa-check' : 'fa-check-double' %> h-2.5 w-2.5 <%= locals.delivery === 'read' ? 'text-info' : 'text-text-disabled' %>" aria-hidden="true"></i><span class="sr-only"><%= dl[locals.delivery] %></span></span><% } %><% if (actions.length > 0) { %><span role="group" aria-label="<%= locals.actionsLabel || 'Message actions' %>" class="inline-flex items-center gap-1 transition-opacity opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 [@media(hover:none)]:opacity-100"><% actions.forEach(function (a) { %><button type="button"<% if (a.disabled) { %> disabled<% } %> title="<%= a.label %>"<% if (a.icon) { %> aria-label="<%= a.label %>"<% } %> data-chat-action="<%= a.id %>"<% if (locals.messageId != null) { %> data-chat-message="<%= locals.messageId %>"<% } %><% if (typeof a.onClick === 'string') { %> data-chat-fn="<%= a.onClick %>"<% } %> class="inline-flex items-center gap-1 rounded px-1 py-0.5 text-[11px] text-text-secondary hover:bg-surface-overlay <%= a.destructive ? 'hover:text-error' : 'hover:text-text-primary' %> focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus disabled:opacity-50 disabled:cursor-not-allowed"><% if (a.icon) { %><span aria-hidden="true"><i class="<%= a.icon %>" aria-hidden="true"></i></span><% } else { %><%= a.label %><% } %></button><% }); %></span><% } %></div><% } %></div></article><% } %>
