<%
  // DescriptionList — label/value pairs of one record, for detail pages (phase 11.11). Same DOM, classes, local
  // names and defaults as kui-react modules/ui/DescriptionList.tsx.
  //
  // One <dl>, the same spacing, an empty value shown as a dash, an optional copy button for ids and keys, and 1–3
  // columns that collapse to one on a phone. `inline` puts label and value side by side (a key/value sheet);
  // `stacked` puts the label above the value.
  //
  // Locals:
  //   items       — [{ id?, label, value, hint?, copyValue?, mono?, wide?, hidden? }]
  //     id        — stable key (kept for parity; the markup does not carry it)
  //     label     — escaped text
  //     value     — escaped text; null, undefined, false and '' are empty and show `emptyValue`
  //     valuePartial / valueLocals — absolute path of a partial drawn as the value (React takes a node there, e.g.
  //                 a Badge), with its locals; such a value is never empty
  //     hint      — small text under the value, escaped
  //     copyValue — adds a copy button; the string is what gets copied (an id, a key, an address)
  //     mono      — monospace value (ids, hashes, codes)
  //     wide      — spans every column of the grid (a long description, an address)
  //     hidden    — left out
  //   columns     — 1 (default) | 2 | 3
  //   layout      — 'inline' (default: label left, value right) | 'stacked' (label above value)
  //   emptyValue  — shown for an empty value (default '—')
  //   dense       — tighter rows (default false)
  //   divided     — hairlines between rows (inline layout, one column; default true)
  //   messages    — { copy?, copied? } (default 'Copy' / 'Copied')
  //   className   — extra classes on the <dl>
  //   loadRuntime — default true: inline DescriptionList/scripts/description-list.js when an item has a copy
  //                 button (false when the page loads it once and calls KuiDescriptionList.autoInit())
  //
  // The copy button writes `copyValue` to the clipboard, then shows the check icon and the `copied` label for
  // 1.5 s, like React. `data-dl-*` attributes are the browser script's hooks.
  var _items      = Array.isArray(locals.items) ? locals.items : [];
  var _columns    = locals.columns === 2 || locals.columns === 3 ? locals.columns : 1;
  var _layout     = locals.layout === 'stacked' ? 'stacked' : 'inline';
  var _emptyValue = locals.emptyValue != null ? locals.emptyValue : '—';
  var _dense      = locals.dense === true;
  var _divided    = locals.divided !== false;
  var _m          = Object.assign({ copy: 'Copy', copied: 'Copied' }, locals.messages || {});
  var _className  = locals.className || '';

  var COLUMNS = {
    1: 'grid-cols-1',
    2: 'grid-cols-1 sm:grid-cols-2',
    3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
  };
  var _inline = _layout === 'inline';
  var _rows   = _inline && _columns === 1 && _divided;
  var _shown  = _items.filter(function (i) { return i && !i.hidden; });
  function _isEmpty(item) {
    if (item.valuePartial) return false;
    var v = item.value;
    return v === null || v === undefined || v === false || v === '';
  }
  var _hasCopy = _shown.some(function (i) { return i.copyValue && !_isEmpty(i); });

  var _dlClass = 'grid gap-x-6 ' + COLUMNS[_columns] + ' ' + (_rows ? 'divide-y divide-border' : _dense ? 'gap-y-2' : 'gap-y-4') +
    (_className ? ' ' + _className : '');
  var _itemClass = 'min-w-0' + (_inline
    ? ' flex items-start justify-between gap-4' + (_rows ? (_dense ? ' py-1.5' : ' py-2.5') : '')
    : ' flex flex-col gap-1');
%>
<dl class="<%= _dlClass %>" data-layout="<%= _layout %>"<% if (_hasCopy) { %> data-dl-root data-dl-copy-label="<%= _m.copy %>" data-dl-copied-label="<%= _m.copied %>"<% } %>>
  <% _shown.forEach(function (item) { var empty = _isEmpty(item); %>
  <div class="<%= _itemClass %><%= item.wide ? ' sm:col-span-full' : '' %>" data-part="item">
    <dt class="text-sm text-text-secondary<%= _inline ? ' shrink-0' : '' %>"><%= item.label != null ? item.label : '' %></dt>
    <dd class="min-w-0 text-sm text-text-primary<%= _inline ? ' text-right' : '' %>">
      <span class="inline-flex max-w-full items-center gap-1<%= _inline ? ' justify-end' : '' %>">
        <span class="min-w-0 break-words<%= item.mono ? ' font-mono text-xs' : '' %>"><% if (empty) { %><span class="text-text-disabled"><%= _emptyValue %></span><% } else if (item.valuePartial) { %><%- include(item.valuePartial, item.valueLocals || {}) %><% } else { %><%= item.value %><% } %></span>
        <% if (item.copyValue && !empty) { %><button type="button" aria-label="<%= _m.copy %>" title="<%= _m.copy %>" class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded text-text-secondary transition-colors hover:bg-surface-overlay hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus" data-part="copy" data-dl-copy="<%= item.copyValue %>"><i class="fa-solid fa-copy w-3 h-3" aria-hidden="true"></i></button><% } %>
      </span>
      <% if (item.hint) { %><span class="mt-0.5 block text-xs text-text-secondary"><%= item.hint %></span><% } %>
    </dd>
  </div>
  <% }); %>
</dl>
<% if (_hasCopy && locals.loadRuntime !== false) { %>
<script>
<%- include('./DescriptionList/scripts/description-list.js') %>
(function () { if (window.KuiDescriptionList) window.KuiDescriptionList.autoInit(); })();
</script>
<% } %>
