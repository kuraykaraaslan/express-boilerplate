    });
  };
  var _rowActionsLabel = function (row) {
    return typeof locals.rowActionsLabel === 'function' ? locals.rowActionsLabel(row) : (locals.rowActionsLabel || _m.rowActions);
  };
  var _ellipsisBtn = function (label) {
    return '<button type="button" aria-label="' + String(label).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') + '"'
      + ' class="inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus disabled:opacity-50 disabled:cursor-not-allowed bg-transparent text-text-primary hover:bg-surface-overlay p-1.5 text-sm">'
      + '<i class="fa-solid fa-ellipsis-vertical w-3.5 h-3.5" aria-hidden="true"></i></button>';
  };
  var _totalCols = (_selectable ? 1 : 0) + (_renderExpanded ? 1 : 0) + _columns.length + (_rowActions ? 1 : 0);
  var _checkboxClass = 'h-4 w-4 rounded border-border text-primary accent-[var(--primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus disabled:opacity-50 disabled:cursor-not-allowed';
%>
<% _rows.forEach(function (row, ri) {
     var _rid = _rowIdOf(row, _offset + ri);
     var _ridJson = JSON.stringify(_rid);
     var _locked = !!_lockedOf(row);
     var _grp = _groupOf(row);
     var _isSel = _selectable && (_locked || _selectedKeys.indexOf(_ridJson) !== -1);
     var _live = _stateOf(row);
     var _extra = _classOf(row) || '';
     var _allowed = _canSelect(row);
     if (_cards) {
       var _menu = null;
       if (_rowActions) {
         var _cardItems = _rowActionItems(row);
         if (_cardItems.some(function (it) { return !it.hidden; })) {
           _menu = '<div class="inline-flex" data-part="row-actions">'
             + include('../../DropdownMenu', _atom({ id: _tableId + '-actions-' + (_offset + ri), portal: true, align: 'right', items: _cardItems, trigger: _ellipsisBtn(_rowActionsLabel(row)) }))
             + '</div>';
         }
       }
       // kui-react renderCard(row, ctx); toggleSelected is the attribute that makes a control inside the
       // card toggle the row's selection (a click handler cannot cross from the server).
       var _cardHtml = locals.renderCard(row, {
         id: _rid,
         selected: _isSel,
         selectable: _selectable ? _allowed : 'not selectable',
         locked: _locked,
         toggleSelected: 'data-dt-card-select',
         actions: _menu
       });
%>
<li class="min-w-0<%= _live === 'leaving' ? ' opacity-40 transition-opacity duration-500' : '' %><%= _extra ? ' ' + _extra : '' %>" data-dt-row="<%= ri %>" data-dt-row-id="<%= _ridJson %>"<% if (_isSel) { %> data-selected="true"<% } %> data-row-key="<%= String(_rid) %>"<% if (_live) { %> data-state="<%= _live %>"<% } %><% if (_locked) { %> data-dt-locked<% } %><% if (_grp) { %> data-dt-group="<%= _grp.key %>" data-dt-group-label="<%= _grp.label %>"<% } %>><%- _cardHtml %></li>
<%   return;
     }
     var _detail = _renderExpanded ? _renderExpanded(row) : null;
     var _hasDetail = _detail !== null && _detail !== undefined && _detail !== false && _detail !== '';
     var _detailId = _tableId + '-detail-' + String(_rid).replace(/[^\w-]/g, '_');
     var _trStyle = _css(_styleOf(row));
     var _trClass = (_unstyled ? '' : 'hover:bg-surface-overlay transition-[background-color,opacity] duration-500')
       + (_isSel || _live === 'new' ? ' bg-primary-subtle' : '')
       + (_live === 'leaving' ? ' opacity-40' : '')
       + (_clickable ? ' cursor-pointer' : '')
       + (_keyboard ? ' focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-border-focus' : '')
       + (_extra ? ' ' + _extra : '');
%>
<tr class="<%= _trClass.trim() %>" data-dt-row="<%= ri %>" data-dt-row-id="<%= _ridJson %>"<% if (_isSel) { %> data-selected="true"<% } %> data-row-key="<%= String(_rid) %>"<% if (_live) { %> data-state="<%= _live %>"<% } %><% if (_trStyle) { %> style="<%= _trStyle %>"<% } %><% if (_keyboard) { %> tabindex="<%= ri === 0 ? '0' : '-1' %>"<% } %><% if (_isSel) { %> aria-selected="true"<% } %><% if (_locked) { %> data-dt-locked<% } %><% if (_grp) { %> data-dt-group="<%= _grp.key %>" data-dt-group-label="<%= _grp.label %>"<% } %>>
  <% if (_selectable) { %>
  <td class="w-10 px-4 py-3" data-part="select"<% if (_locked) { %> data-locked="true"<% } %>>
    <input type="checkbox" aria-label="<%= typeof locals.rowSelectLabel === 'function' ? locals.rowSelectLabel(row) : _m.selectRow + ' ' + (_offset + ri + 1) %>" data-dt-select<% if (typeof locals.rowSelectLabel === 'function') { %> data-dt-own-label<% } %> class="<%= _checkboxClass %>"<% if (_isSel) { %> checked<% } %><% if (_allowed !== true) { %> disabled title="<%= _allowed %>"<% } else if (_locked) { %> disabled<% } %>>
  </td>
  <% } %>
  <% if (_renderExpanded) { %>
  <td class="w-10 px-4 py-3" data-part="expand">
    <% if (_hasDetail) { %>
    <button type="button" aria-label="<%= _m.expandRow %>" aria-expanded="false" data-dt-expand="<%= _detailId %>" data-label-expand="<%= _m.expandRow %>" data-label-collapse="<%= _m.collapseRow %>" class="rounded text-text-disabled transition-colors hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus">
      <%# kui-react's svg carries w-2.5 h-2.5, but Font Awesome's own 1.25em x 1em wins; the bare <i> measures the same. %>
      <i class="fa-solid fa-chevron-right w-2.5 h-2.5" data-dt-expand-icon aria-hidden="true"></i>
    </button>
    <% } %>
  </td>
  <% } %>
  <% _columns.forEach(function (col) { %>
  <td class="<%= _tdClass(col, row).trim() %>"<% var _tds = _tdStyle(col, row); if (_tds) { %> style="<%= _tds %>"<% } %><% if (!col.render) { %> data-dt-key="<%= col.key %>"<% } %><% if (locals.columnChooser) { %> data-dt-col="<%= col.key %>"<% } %>><% if (col.render) { %><%- col.render(row, { index: ri, id: _rid }) %><% } else { %><%= row[col.key] !== undefined && row[col.key] !== null ? row[col.key] : '' %><% } %></td>
  <% }); %>
  <% if (_rowActions) {
       var _items = _rowActionItems(row);
       var _anyVisible = _items.some(function (it) { return !it.hidden; });
  %>
  <td class="w-12 px-2 py-2 text-right" data-part="row-actions" onclick="event.stopPropagation()">
    <% if (_anyVisible) { %>
    <%- include('../../DropdownMenu', _atom({ id: _tableId + '-actions-' + (_offset + ri), portal: true, align: 'right', items: _items, trigger: _ellipsisBtn(_rowActionsLabel(row)) })) %>
    <% } %>
  </td>
  <% } %>
</tr>
<% if (_hasDetail) { %>
<tr id="<%= _detailId %>" class="bg-surface-sunken hidden" data-part="detail" data-dt-detail="<%= ri %>">
  <td colspan="<%= _totalCols %>" class="px-6 py-3 text-sm text-text-secondary"><%- _detail %></td>
</tr>
<% } %>
<% }); %>
