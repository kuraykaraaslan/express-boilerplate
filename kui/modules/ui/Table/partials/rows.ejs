  // EJS hands every include the caller's locals too; blank them so the table's own locals never reach
  // the menu as its options.
  function _atom(own) {
    var o = {};
    Object.keys(locals).forEach(function (k) { o[k] = undefined; });
    return Object.assign(o, own);
  }

  function _rowIdOf(row, fallback) {
    if (typeof locals.rowId === 'function') return locals.rowId(row);
    if (typeof locals.rowId === 'string' && locals.rowId) return row[locals.rowId];
