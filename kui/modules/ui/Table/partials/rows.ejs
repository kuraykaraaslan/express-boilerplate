  var _groupRows = {};
  if (_groupBy) _rows.forEach(function (r) { var g = String(_groupBy(r)); (_groupRows[g] = _groupRows[g] || []).push(r); });
  /** The row's group key and its header (the HTML of renderGroupHeader, else the key as text), or null. */
  function _groupOf(row) {
    if (!_groupBy) return null;
    var g = String(_groupBy(row));
    var label = typeof locals.renderGroupHeader === 'function'
      ? String(locals.renderGroupHeader(g, _groupRows[g] || []))
