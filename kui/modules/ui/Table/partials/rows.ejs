  var _cellPad = _density === 'compact' ? 'px-3 py-1.5' : 'px-4 py-3';
  function _cellClass(col) {
    // unstyled (kui-react cellClassFor(column, '')): no density padding or colour of the table's own.
    return (locals.unstyled ? '' : _cellPad + ' text-text-primary')
      + (col.align && col.align !== 'left' ? ' ' + (_alignClass[col.align] || '') : '')
      + (col.hideBelow && _hideBelow[col.hideBelow] ? ' ' + _hideBelow[col.hideBelow] : '')
      + (col.tdClass ? ' ' + col.tdClass : '');
  }
  var _cards = locals.layout === 'cards' && typeof locals.renderCard === 'function';
  // A row click handler (a global function name, or true for the 'kui:dt-row-click' event alone).
  var _clickable = !!locals.onRowClick || !!locals.onRowDoubleClick;
  // Keyboard rows: one row in the tab order, arrows / Home / End move; on by default with a row click.
  var _keyboard = locals.keyboardNavigation !== undefined ? !!locals.keyboardNavigation : _clickable;
  var _unstyled = !!locals.unstyled;
  // A style local: a CSS string as is, or a style object (camelCase keys; a bare number is pixels, as in React).
  var _unitless = { opacity: 1, zIndex: 1, fontWeight: 1, lineHeight: 1, flex: 1, flexGrow: 1, flexShrink: 1, order: 1, zoom: 1 };
  function _css(v) {
    if (!v) return '';
    if (typeof v === 'string') return v;
    return Object.keys(v).filter(function (k) { return v[k] !== undefined && v[k] !== null && v[k] !== ''; }).map(function (k) {
      var name = k.indexOf('--') === 0 ? k : k.replace(/[A-Z]/g, function (c) { return '-' + c.toLowerCase(); });
      var val = typeof v[k] === 'number' && !_unitless[k] ? v[k] + 'px' : String(v[k]);
      return name + ':' + val;
    }).join(';');
  }
  var _styleOf = typeof locals.rowStyle === 'function' ? locals.rowStyle : function () { return undefined; };
