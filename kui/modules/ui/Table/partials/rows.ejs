  var _selectable = !!locals.selectable;
  var _renderExpanded = typeof locals.renderExpanded === 'function' ? locals.renderExpanded : null;
  var _m = {};
%><%- include('./_messages', { out: _m, messages: locals.messages }) -%><%
  var _selectedIds = Array.isArray(locals.selectedRowIds) ? locals.selectedRowIds
    : (Array.isArray(locals.defaultSelectedRowIds) ? locals.defaultSelectedRowIds : []);
  var _selectedKeys = _selectedIds.map(function (x) { return JSON.stringify(x); });
  var _alignClass = { left: 'text-left', center: 'text-center', right: 'text-right' };
  // kui-react core/columnHelpers.ts: hideBelowClass and densityCellClass.
  var _hideBelow = { sm: 'hidden sm:table-cell', md: 'hidden md:table-cell', lg: 'hidden lg:table-cell' };
