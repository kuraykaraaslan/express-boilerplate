  }
  function _tdStyle(col, row) { return typeof col.cellStyle === 'function' ? _css(col.cellStyle(row)) : ''; }
  var _stateOf = typeof locals.rowState === 'function' ? locals.rowState : function () { return undefined; };
  var _classOf = typeof locals.rowClassName === 'function' ? locals.rowClassName : function () { return ''; };
