  // shown as a menu in a trailing column. Every per-row field may be a function of the row.
  var _rowActions = Array.isArray(locals.rowActions) && locals.rowActions.length ? locals.rowActions : null;
  var _per = function (v, row) { return typeof v === 'function' ? v(row) : v; };
  var _rowActionItems = function (row) {
    return _rowActions.map(function (a) {
      return {
        type: 'item', id: a.id, label: a.label, icon: a.icon,
        href: _per(a.href, row), onClick: _per(a.onClick, row),
        hidden: _per(a.hidden, row), disabled: _per(a.disabled, row),
        disabledReason: _per(a.disabledReason, row),
        danger: !!a.destructive, order: a.order, group: a.group
