              <% } %>
              <%# The order badge only matters with several sorted columns (kui-react draws it only then). %>
              <% if (_multiSort || !_unstyled) { %><span class="<%= _order > 0 ? 'inline-flex' : 'hidden' %> ml-0.5 h-4 min-w-[1rem] items-center justify-center rounded-full bg-primary text-[10px] font-bold text-primary-fg px-1" data-dt-sort-order aria-hidden="true"><%= _order > 0 ? _order : '' %></span><% } %>
              <% } else if (col.headerHtml) { %>
              <%- col.headerHtml %>
              <% } else { %>
              <%= col.header %>
              <% } %>
              <% if (col.filter) { %>
              <span class="relative inline-flex">
                <button
                  type="button"
                  data-dt-filter-trigger="<%= col.key %>"
                  data-dt-filter-kind="<%= col.filter.kind || 'text' %>"
                  aria-label="<%= _fill(_fv ? _m.editColumnFilter : _m.columnFilter, { column: _headerText(col) }) %>"
                  aria-expanded="false"
                  class="inline-flex items-center justify-center rounded p-1 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus <%= _fv ? 'text-primary hover:text-primary-hover' : 'text-text-disabled hover:text-text-primary' %>"
                >
                  <i class="fa-solid fa-filter w-2.5 h-2.5" aria-hidden="true"></i>
                </button>
              </span>
              <% } %>
            </span>
          </th>
          <% }); %>
          <% if (_rowActions) { %>
          <th scope="col" class="w-12 px-2 py-3"><span class="sr-only"><%= _actionsColumnLabel %></span></th>
          <% } %>
        </tr>
      </thead>
      <tbody<% if (!_unstyled) { %> class="divide-y divide-border bg-surface-base"<% } %> data-dt-body>
        <% if (_state === 'loading') { %>
        <tr data-dt-state-row>
          <td colspan="<%= _colCount %>" class="px-4 py-10 text-center text-sm text-text-secondary">
            <span class="inline-flex items-center gap-2"><%- include('../../Spinner', _atom({ size: 'sm', label: null })) %><%= _loadingMessage %></span>
          </td>
        </tr>
        <% } else if (_state === 'error') { %>
        <tr data-dt-state-row>
          <td colspan="<%= _colCount %>" role="alert" class="px-4 py-10 text-center text-sm text-error-fg bg-error-subtle"><span class="inline-flex flex-col items-center gap-2"><span><%= _stateError %></span><% if (_canRetry) { %><%- include('../../Button', _atom({ variant: 'outline', size: 'xs', children: _m.retry })).trim().replace(/^<button/, '<button data-part="retry"') %><% } %></span></td>
        </tr>
        <% } else if (_bodyRows.length === 0) { %>
        <tr data-dt-empty>
          <td colspan="<%= _colCount %>" class="px-4 py-10 text-center text-sm text-text-secondary"><%= _stateText %></td>
        </tr>
        <% } %>
        <% if (_state !== 'loading' && _state !== 'error') { %>
        <%- include('./rows', _rowsLocals) %>
        <% } %>
      </tbody>
      <% if (_hasFooter) { %>
      <tfoot class="border-t border-border bg-surface-sunken font-medium<%= _ready ? '' : ' hidden' %>" data-part="footer" data-dt-footer>
        <tr>
          <% if (_leadingCount > 0) { %><td colspan="<%= _leadingCount %>"></td><% } %>
          <% _columns.forEach(function (col) { %>
          <td class="<%= _cellClass(col).trim() %>"<% if (_chooser) { %> data-dt-col="<%= col.key %>"<% } %>><%= col.footer !== undefined && col.footer !== null ? col.footer : '' %></td>
          <% }); %>
          <% if (_rowActions) { %><td></td><% } %>
        </tr>
      </tfoot>
      <% } %>
    </table>
    <%# The boot script sits inside the last box of the root, after everything it binds: a script as the
        last child would take :last-child from the box before it and give it a space-y margin. %>
    <% if (!_paginated) { %><%- include('../scripts/data-table-script', { config: _config }) %><% } %>
  </div>
  <% } %>

  <% if (_paginated) { %>
  <div class="flex items-center justify-between gap-4 flex-wrap<%= _isCard ? ' border-t border-border px-4 py-3' : '' %>" data-part="pagination">
    <p class="text-xs text-text-secondary" data-dt-status></p>
    <nav aria-label="<%= _m.pagination %>" class="flex items-center gap-1 flex-wrap" data-dt-pagination></nav>
    <%- include('../scripts/data-table-script', { config: _config }) %>
  </div>
  <% } %>
</div>
