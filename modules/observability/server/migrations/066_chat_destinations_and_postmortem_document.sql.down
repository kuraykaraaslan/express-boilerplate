-- DOWN for 066_chat_destinations_and_postmortem_document.sql: chat destinations and the postmortem document link.
--
-- NEVER auto-run; manual rollback only; destroys the data of the dropped tables/columns. The migration runner loads `*.sql` files only,
-- so this `.sql.down` file is ignored by `db:deploy`, the release manifest and the schema version.
--
-- Data lost: every row of `chat_destinations` (their sealed webhook URLs included) and the document/review columns of `incident_postmortems`
-- (documentId, documentVersionNo, approvalItemId, reviewMode, reviewOutcome, reviewedAt). The document rows a publication created stay in the document
-- module, under its own retention rules.
--
-- Run it by hand, inside one transaction, with the target schema ALONE on the search path (an unqualified DROP ... IF EXISTS resolves through
-- the path: never leave `public` behind another schema), after a backup and with the observability workers stopped. Undo the migrations newest first; the whole procedure is docs/guides/observability/rollback.md:
--   PGOPTIONS='-c search_path=<schema>' psql "$DATABASE_URL_UNPOOLED" -v ON_ERROR_STOP=1 --single-transaction -f 066_chat_destinations_and_postmortem_document.sql.down
-- Idempotent: every statement is a no-op when its object is already gone. Proven by modules/observability/scripts/rollback-proof.mts.

-- 1. The table (its indexes go with it; no CASCADE).
DROP TABLE IF EXISTS "chat_destinations";

-- 2. Columns added to the pre-existing `incident_postmortems` table.
ALTER TABLE IF EXISTS "incident_postmortems" DROP COLUMN IF EXISTS "reviewedAt";
ALTER TABLE IF EXISTS "incident_postmortems" DROP COLUMN IF EXISTS "reviewOutcome";
ALTER TABLE IF EXISTS "incident_postmortems" DROP COLUMN IF EXISTS "reviewMode";
ALTER TABLE IF EXISTS "incident_postmortems" DROP COLUMN IF EXISTS "approvalItemId";
ALTER TABLE IF EXISTS "incident_postmortems" DROP COLUMN IF EXISTS "documentVersionNo";
ALTER TABLE IF EXISTS "incident_postmortems" DROP COLUMN IF EXISTS "documentId";

-- Forget the migration in the ledger, so the next `db:deploy` applies the up file again instead of skipping it.
DO $$
BEGIN
  IF to_regclass('_sql_migrations') IS NOT NULL THEN
    DELETE FROM _sql_migrations WHERE name = 'observability:066_chat_destinations_and_postmortem_document.sql';
  END IF;
END $$;
