-- DOWN for 004_incident_management.sql: incident management v2.
--
-- NEVER auto-run; manual rollback only; destroys the data of the dropped tables/columns. The migration runner loads `*.sql` files only,
-- so this `.sql.down` file is ignored by `db:deploy`, the release manifest and the schema version.
--
-- Data lost: every row of incident_events (the incident timeline), incident_participants, incident_postmortems and incident_update_templates, and the four added `incidents` columns (acknowledgedAt, acknowledgedBy, mitigatedAt, declaredBy). Migration 020 adds `managedBy` to incident_update_templates: undo 020 first.
--
-- Run it by hand, inside one transaction, with the target schema ALONE on the search path (an unqualified DROP ... IF EXISTS resolves through
-- the path: never leave `public` behind another schema), after a backup and with the observability workers stopped. Undo the migrations newest first; the whole procedure is docs/guides/observability/rollback.md:
--   PGOPTIONS='-c search_path=<schema>' psql "$DATABASE_URL_UNPOOLED" -v ON_ERROR_STOP=1 --single-transaction -f 004_incident_management.sql.down
-- Idempotent: every statement is a no-op when its object is already gone. Proven by modules/observability/scripts/rollback-proof.mts.

-- 1. Columns added to the pre-existing `incidents` table.
ALTER TABLE IF EXISTS "incidents" DROP COLUMN IF EXISTS "declaredBy";
ALTER TABLE IF EXISTS "incidents" DROP COLUMN IF EXISTS "mitigatedAt";
ALTER TABLE IF EXISTS "incidents" DROP COLUMN IF EXISTS "acknowledgedBy";
ALTER TABLE IF EXISTS "incidents" DROP COLUMN IF EXISTS "acknowledgedAt";

-- 2. The tables, newest first (indexes go with them; no CASCADE, see 002).
DROP TABLE IF EXISTS "incident_update_templates";
DROP TABLE IF EXISTS "incident_postmortems";
DROP TABLE IF EXISTS "incident_participants";
DROP TABLE IF EXISTS "incident_events";

-- Forget the migration in the ledger, so the next `db:deploy` applies the up file again instead of skipping it.
DO $$
BEGIN
  IF to_regclass('_sql_migrations') IS NOT NULL THEN
    DELETE FROM _sql_migrations WHERE name = 'observability:004_incident_management.sql';
  END IF;
END $$;
