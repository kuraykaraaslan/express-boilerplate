-- DOWN for 002_alert_pipeline.sql: the alert pipeline.
--
-- NEVER auto-run; manual rollback only; destroys the data of the dropped tables/columns. The migration runner loads `*.sql` files only,
-- so this `.sql.down` file is ignored by `db:deploy`, the release manifest and the schema version.
--
-- Data lost: every row of alerts, alert_integrations, alert_routes, alert_silences and alert_dependencies (including the integration key hashes), and `incidents.alertGroupKey`.
--
-- Run it by hand, inside one transaction, with the target schema ALONE on the search path (an unqualified DROP ... IF EXISTS resolves through
-- the path: never leave `public` behind another schema), after a backup and with the observability workers stopped. Undo the migrations newest first; the whole procedure is docs/guides/observability/rollback.md:
--   PGOPTIONS='-c search_path=<schema>' psql "$DATABASE_URL_UNPOOLED" -v ON_ERROR_STOP=1 --single-transaction -f 002_alert_pipeline.sql.down
-- Idempotent: every statement is a no-op when its object is already gone. Proven by modules/observability/scripts/rollback-proof.mts.

-- 1. What was added to the pre-existing `incidents` table: the index, then the column.
DROP INDEX IF EXISTS "idx_incidents_alert_group";
ALTER TABLE IF EXISTS "incidents" DROP COLUMN IF EXISTS "alertGroupKey";

-- 2. The tables, newest first. Their indexes and primary keys go with them. No foreign keys exist between them, so no CASCADE is used: a
--    dependent object this migration did not create makes the statement fail instead of being dropped silently.
DROP TABLE IF EXISTS "alert_dependencies";
DROP TABLE IF EXISTS "alert_silences";
DROP TABLE IF EXISTS "alert_routes";
DROP TABLE IF EXISTS "alert_integrations";
DROP TABLE IF EXISTS "alerts";

-- Forget the migration in the ledger, so the next `db:deploy` applies the up file again instead of skipping it.
DO $$
BEGIN
  IF to_regclass('_sql_migrations') IS NOT NULL THEN
    DELETE FROM _sql_migrations WHERE name = 'observability:002_alert_pipeline.sql';
  END IF;
END $$;
