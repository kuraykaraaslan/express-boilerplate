        "HTTP",
        "TCP",
        "PING",
        "DNS",
        "TLS",
        "DOMAIN",
        "HEARTBEAT",
        "STEPS",
        "BROWSER"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "intervalSeconds": {
      "default": 60,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "timeoutMs": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
