{
  "$schema": "../module.schema.json",
  "id": "redis_idempotency",
  "name": "Idempotency Keys",
  "description": "Redis-backed idempotency-key store for safely retryable POST/PATCH operations.",
  "version": "1.0.0",
  "tier": "infrastructure",
  "edition": "core",
  "placement": "core",
  "roles": ["single", "node", "fleet"],
  "icon": "fas fa-clone",
  "tags": [
    "infrastructure",
    "reliability"
  ],
  "priority": 5,
  "dependencies": {
    "requires": [
      "env",
      "redis",
      "db",
      "tenant_setting"
    ]
  },
  "exports": {
    "RedisIdempotencyService": "redis_idempotency.service.ts"
  },
  "permissions": [
    {
      "id": "redis_idempotency.settings.read",
      "name": "View how long retried requests are remembered",
      "description": "Root tenant only. How long the installation keeps Idempotency-Key claims.",
      "group": "Platform",
      "minRole": "ADMIN"
    },
    {
      "id": "redis_idempotency.settings.update",
      "name": "Change how long retried requests are remembered",
      "description": "Root tenant only. Each time can only be made longer than the built-in one.",
      "group": "Platform",
      "minRole": "ADMIN"
    }
  ],
  "routes": [
    {
      "path": "/admin/platform/idempotency/settings",
      "placement": "root",
      "component": "redis_idempotency/ui/redis-idempotency-settings.page",
      "permissions": [
        "redis_idempotency.settings.read",
        "tenant_setting.config.read"
      ]
    }
  ],
  "author": "Kuray Karaaslan",
  "homepage": "https://github.com/kuraykaraaslan/next-boilerplate/tree/main/modules/redis_idempotency",
  "license": "Proprietary"
}
