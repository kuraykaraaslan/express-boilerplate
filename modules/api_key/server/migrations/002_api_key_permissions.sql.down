-- DOWN for 002_api_key_permissions.sql: per-module API key permissions.
--
-- NEVER auto-run; manual rollback only; destroys the keys' module permission lists and review marks (the previous release
-- accepts no key on module routes, so no integration of that release depends on them).
ALTER TABLE "api_keys" DROP COLUMN IF EXISTS "permissions";
ALTER TABLE "api_keys" DROP COLUMN IF EXISTS "scopeReview";

-- the ledger row, so a later deploy applies the file again
DO $$
BEGIN
  IF to_regclass('_sql_migrations') IS NOT NULL THEN
    DELETE FROM _sql_migrations WHERE name = 'api_key:002_api_key_permissions.sql';
  END IF;
END $$;
