      "point": "ai_firewall:signal",
      "key": "firewall_signals",
      "export": "auth/server/auth.firewall-signals",
      "scope": "system",
      "description": "Phase 55 01.6: the signal kinds this module emits (the audit actions it owns), each attribute with its personal-data class. Read by ai_firewall through its registry; imports only the contract from common.",
      "metadata": {
        "label": "auth: sign-ins, passwords, second factors, magic links, session hand-offs; refused callbacks and refreshes, codes and verification mails sent, authenticator setups, blocked sign-ups (phase 55 01.6, 02.6)",
        "ids": [
          "auth.login",
          "auth.login_failed",
          "auth.account_disabled",
          "auth.register",
          "auth.password_changed",
          "auth.password_reset",
          "auth.forgot_password",
          "auth.email_verified",
          "auth.otp_verified",
          "auth.dormant_disabled",
          "auth.second_factor_failed",
          "auth.second_factor_blocked",
          "auth.second_factor_unblocked",
          "auth.recovery_code_used",
          "auth.magic_link.requested",
          "auth.magic_link.consumed",
          "user_session.exchange",
          "user_session.handoff",
          "tenant.self_service_created",
          "auth.callback_refused",
          "auth.refresh_refused",
          "auth.otp_sent",
          "auth.verify_email_sent",
          "auth.totp_setup_started",
          "auth.signup_blocked"
        ],
        "routes": [
          "/api/auth/login",
          "/api/auth/device/login",
          "/api/auth/register",
          "/api/auth/change-password",
          "/api/auth/forgot-password",
          "/api/auth/reset-password",
          "/api/auth/verify-email/verify",
          "/api/auth/otp/verify",
          "/api/auth/step-up/verify",
          "/api/auth/totp/disable",
          "/api/auth/totp/enable",
          "/api/auth/magic-link",
          "/api/auth/magic-link/consume",
          "/api/auth/session/exchange",
          "/api/auth/session/handoff",
          "/api/auth/onboarding",
          "/api/auth/callback",
          "/api/auth/refresh",
          "/api/auth/device/refresh",
          "/api/auth/otp/send",
          "/api/auth/verify-email/send",
          "/api/auth/totp/setup"
