  "extensionPoints": [
    {
      "id": "captcha:provider",
      "kind": "provider",
      "pattern": "select",
      "onFailure": "fail-closed",
      "fallback": "any",
      "persists": true,
      "external": true,
      "inTree": false,
      "description": "A CAPTCHA verification backend (reCAPTCHA / hCaptcha / Turnstile). Sandboxed community plugins (the captcha plugin family) contribute their token-verification here."
    },
    {
      "id": "auth:consent_sink",
      "kind": "provider",
      "pattern": "first",
      "description": "Where 'this person agreed to this' is written. Default export: (event) => Promise<boolean> — return true when the event was recorded, false to let auth fall back. Events are either DOCUMENT (terms/privacy accepted at a named version — a registration consent has no content hash, and the ledger must not pretend otherwise) or PURPOSE (marketing/analytics granted or withdrawn). The point exists because terms_consent is the surviving ledger (DUP-03) but auth CANNOT hard-require it: a deployment that sells no agreements still has to register users (AGENTS.md §10). With no contributor, auth writes its own lightweight user_consents row exactly as before; with terms_consent installed, registration and JIT-SSO consents land in the same table as checkout acceptances instead of a parallel one nothing joins to. Best-effort by contract — a consent write must never block a signup."
    },
    {
      "id": "auth:login_method",
      "kind": "component",
      "pattern": "component",
      "slot": "auth.login.methods",
      "description": "An alternative sign-in method on the login page (passkey, e-signature, ...). Implemented through the CLIENT slot 'auth.login.methods': a contributor declares slots[] = { slot: 'auth.login.methods', component, order, scope: 'tenant' } and the page resolves it through the generated client component map. Props received: { tenantId, onSuccess(message) } — the contribution supplies its own success wording, because the module owning the method is the one that knows what it is called. Declared so `auth` never imports an authentication satellite: auth is PROTECTED and always installed, so a static import forced every optional method module on with it, and auth_e_signature requires auth back (MIS-01, audit 2026-08)."
    },
    {
      "id": "auth:session_extension",
      "kind": "provider",
      "pattern": "aggregate",
      "timeoutMs": 2000,
      "description": "Extra named sections a satellite adds to the 'who am I' answer (GET /auth/session and the device login body). Default export: ({ tenantId, userId }) => Promise<Record<string, unknown> | null>; each key of the returned object becomes a top-level field. Reserved fields (user, tenant, tenantMember, userSecurity, tokens) cannot be overwritten. Best-effort by contract: a failing contribution is skipped. Exists so auth never imports a satellite — terms_consent contributes `compliance.pendingAgreements` (required agreements not yet accepted at their current version) without auth knowing it exists (AGENTS.md §10)."
    },
    {
      "id": "auth:step_up_method",
      "kind": "provider",
      "pattern": "select",
      "fallback": "default",
      "description": "A second-factor method for the request-bound step-up (P9-19, auth.step-up.ts), selected by key; auth_passkey contributes `webauthn`. Default export: { available({ userId }), begin({ userId }) => { options, state }, verify({ userId, state, response }) => boolean }: `begin` answers the authenticator options and an opaque state (the challenge) auth keeps with its own single-use challenge; `verify` must answer true only for an assertion by a credential of that user, made with user verification, over that state. A method that is not installed, switched off or failing is simply not offered (TOTP, built into auth, is the fallback); one that disappears between options and verify fails the step-up closed (503). Exists so auth never imports auth_passkey, which requires auth (AGENTS.md §9.2)."
    },
    {
      "id": "auth:local_credentials_policy",
      "kind": "provider",
      "pattern": "guard",
      "timeoutMs": 2000,
      "description": "Whether PEOPLE may hold and use credentials of this deployment (password login, registration, password reset and change, magic link, TOTP setup, passkey login and registration, and the node-local external identity providers: social SSO, tenant SAML, national identity and e-signature login, their JIT registration and Connected Accounts linking). Default export: () => Promise<{ allowed: boolean; reason?: string }>. Every contribution is asked; any refusal, and any contribution that throws, times out or is paused, blocks local credentials (fail closed: the guard only exists where people log in elsewhere). No contribution = allowed, as before. auth answers 403 LOCAL_CREDENTIALS_DISABLED. Exists so auth never imports the fleet: fleet_agent answers it on a node whose region requires Fleet ID (FID-07, decision F15). Break-glass shadow operators do not pass through it."
    },
    {
      "id": "auth:signup_zone",
      "kind": "provider",
      "pattern": "guard",
      "timeoutMs": 2000,
      "description": "Whether a sign-up that the fleet instance's zone chooser sent here (`/auth/onboarding?fleet=1&zone=<id>`) may open a workspace on THIS deployment, and the language it starts with (docs/phases/02-fleet/14-zones-and-central-signup.md, F41). Default export: (zoneId: string) => Promise<{ ok: true; zoneId; domain; defaultLocale } | { ok: false; reason; chooserUrl }>. Asked only on a fleet node; no contribution = the zone means nothing here. Any refusal, and any contribution that throws, times out or is paused, refuses the sign-up (fail closed). Exists so auth never imports the fleet: fleet_agent answers it from the installed trust bundle."
    }
  ],
