-- DOWN for 007_ai_firewall_label_ref_at.sql: labels by the time of their behaviour.
--
-- NEVER auto-run; manual rollback only. The labels stay; the retention and the export read them without the index (slower, same rows).
DROP INDEX IF EXISTS "idx_ai_firewall_labels_ref_at";

-- the ledger row, so a later deploy applies the file again
DO $$
BEGIN
  IF to_regclass('_sql_migrations') IS NOT NULL THEN
    DELETE FROM _sql_migrations WHERE name = 'ai_firewall:007_ai_firewall_label_ref_at.sql';
  END IF;
END $$;
