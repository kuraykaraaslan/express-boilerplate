<% if (locals.logoUrl || (locals.brandName && locals.brandName !== locals.platformName)) { %><div class="brand" style="text-align:center;margin-bottom:16px;"><% if (locals.logoUrl) { %><img src="<%= logoUrl %>" alt="<%= brandName %>" style="max-height:48px;max-width:200px;border:0;"><br><% } %><strong style="font-size:16px;color:#333333;"><%= brandName %></strong></div><% } %><h1 class="header"><%= subject %></h1>
